# Next.js
web/.next/
# The dev/e2e server writes here instead, so a production build can never poison it
# (next.config.ts `distDir`; live-check Session 2, finding C).
web/.next-dev/
web/out/
web/node_modules/

# Python
*.sqlite
analytics/__pycache__/
analytics/**/__pycache__/
analytics/.venv/
analytics/*.egg-info/
analytics/dist/
analytics/.mypy_cache/
analytics/.ruff_cache/
analytics/.pytest_cache/
*.pyc
*.pyo

# Environment files — NEVER commit these
.env.local
.env.*.local
.env.production

# Owner's personal secret vault (SECRETS.local.md). Holds real key values, so it
# must never be tracked. Ignored by name AND by pattern so a copy/rename still
# can't be committed by accident.
SECRETS.local.md
*.local.md

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Vercel
.vercel

# Claude Code local session data — except shared dev-server launch config
.claude/*
!.claude/launch.json
